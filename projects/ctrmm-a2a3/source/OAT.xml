<configuration>
    <oatconfig>
        <licensefile></licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <!--policyitem type="compatibility" name="GPL-2.0+" path="abc/.*" desc="Process that runs independently, invoked by the X process."/-->
                <policyitem type="license" name="CANN-2.0" path=".*" rule="may" group="defaultGroup" filefilter="defaultPolicyFilter" desc=""/>
                <policyitem type="copyright" name="Huawei Technologies Co., Ltd." path=".*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter" desc=""/>
                <!--policyitem type="copyright" name="xxx" path="abc/.*" rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter" desc="Developed by X Company"/-->
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultFilter" desc="Files not to check">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="defaultPolicyFilter" desc="Filters for compatibility，license header policies">
                <filteritem type="filename" name="OAT.xml" desc="Describe commite owner"/>
                <filteritem type="filename" name=".gitmodules" desc="git submodule "/>
                <filteritem type="filename" name="*.xml" desc="xml file"/>
                <filteritem type="filename" name="*.csv" desc="csv file"/>
                <filteritem type="filename" name="*.info" desc="info file"/>
            </filefilter>
            <filefilter name="copyrightPolicyFilter" desc="Filters for copyright header policies">
                <filteritem type="filename" name=".gitmodules" desc="git submodule "/>
                <filteritem type="filename" name="*.xml" desc="xml file"/>
                <filteritem type="filename" name="*.csv" desc="xml csv"/>
                <filteritem type="filename" name="*.info" desc="info file"/>
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="licenseFileNamePolicyFilter" desc="Filters for LICENSE file policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="readmeFileNamePolicyFilter" desc="Filters for README file policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="readmeOpenSourcefileNamePolicyFilter" desc="Filters for README.OpenSource file policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter" desc="Filters for binary file policies">
                <filteritem type="filepath"
                    name="task_submission/精度结果图\.png$"
                    desc="Generated v36 accuracy log summary image; source: scripts/final_submission.py"/>
                <filteritem type="filepath"
                    name="task_submission/性能结果图\.png$"
                    desc="Generated v36 msprof CSV summary image; source: scripts/final_submission.py"/>
                <filteritem type="filepath"
                    name="task_submission/2\.1\ 精度自验证报告\.xlsx$"
                    desc="Generated v36 accuracy workbook; source: scripts/final_submission.py"/>
                <filteritem type="filepath"
                    name="task_submission/3\.1\ 性能自验证报告\.xlsx$"
                    desc="Generated v36 performance workbook; source: scripts/final_submission.py"/>
                <filteritem type="filepath"
                    name="task_submission/4\.1\ 内存自验证报告\.xlsx$"
                    desc="Generated v36 resource record workbook; source: scripts/final_submission.py"/>
                <filteritem type="filename" name="*.csv" desc="binary csv"/>
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>

        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="CANN-2.0" desc="CANN Open Software License Agreement Version 2.0 standard header">
                <licensetext name="
                    This program is free software, you can redistribute it and/or modify it under the terms and conditions of
